{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": [
    "e2e",
    "src",
    "src/**/*.json",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.node.config.ts"
  ],
  "exclude": ["src/generated/ontobff/**/*.ts"],
  "references": [
    { "path": "./tsconfig.generated.json" },
    { "path": "../../packages/core" },
    { "path": "../../packages/data" },
    { "path": "../../packages/decision-patterns" },
    { "path": "../../packages/react" },
    { "path": "../../packages/react-aria" },
    { "path": "../../packages/resource-patterns" },
    { "path": "../../packages/router" },
    { "path": "../../packages/theme-default" }
  ]
}
