        {
          "id": "path:itemId",
          "placeholder": "itemId",
          "valueType": "identifier"
        }
      ],
      "searchParameters": [],
      "requiredPermissions": {
        "kind": "permission",
        "permission": "permission:item.update"
      },
      "unknownSearchParameters": "reject"
    },
    "route:proposal-decision": {
      "id": "route:proposal-decision",
      "path": "/proposals/{proposalId}/decision",
      "interaction": "interaction:proposal-decision",
      "pathParameters": [
        {
          "id": "path:proposalId",
          "placeholder": "proposalId",
