  "queries": {
    "query:list-items": {
      "id": "query:list-items",
      "service": "service:reference",
      "method": "oui.reference.v1.ReferenceFrontendService.ListItems",
      "input": {
        "bindings": {
          "page_size": {
            "source": "literal",
            "value": 25
          },
          "page_token": {
            "source": "search",
            "parameter": "search:page"
          },
          "query": {
            "source": "search",
            "parameter": "search:query"
          },
          "statuses": {
            "source": "search",
            "parameter": "search:status"
          },
          "sort": {
            "source": "search",
            "parameter": "search:sort"
          },
          "direction": {
            "source": "search",
            "parameter": "search:direction"
          }
        }
      },
      "output": {
        "resource": "resource:item",
        "itemsPath": "items"
      },
      "cache": {
        "identity": ["query", "statuses", "page_token"],
        "freshFor": "PT30S"
      },
      "pagination": {
        "kind": "cursor",
        "requestTokenPath": "page_token",
        "responseTokenPath": "next_page_token",
        "resetOn": ["query", "statuses", "sort"]
      }
    },
    "query:get-item": {
      "id": "query:get-item",
      "service": "service:reference",
      "method": "oui.reference.v1.ReferenceFrontendService.GetItem",
      "input": {
        "bindings": {
          "item_id": {
            "source": "route",
            "parameter": "path:itemId"
          }
        }
      },
      "output": {
        "resource": "resource:item",
        "itemPath": "item"
      },
      "cache": {
        "identity": ["item_id"],
        "freshFor": "PT15S"
      }
    },
    "query:get-decision-context": {
      "id": "query:get-decision-context",
      "service": "service:reference",
      "method": "oui.reference.v1.ReferenceFrontendService.GetDecisionContext",
      "input": {
        "bindings": {
          "proposal_id": {
            "source": "route",
            "parameter": "path:proposalId"
          }
        }
      },
      "output": {
        "resource": "resource:proposal",
        "itemPath": "proposal",
        "evidencePath": "evidence",
        "alternativesPath": "alternatives"
      },
      "cache": {
        "identity": ["proposal_id"],
        "freshFor": "PT0S"
      },
      "requiredPermissions": {
        "kind": "permission",
        "permission": "permission:proposal.view"
      }
    }
  },
  "commands": {
    "command:update-item": {
      "id": "command:update-item",
      "service": "service:reference",
      "method": "oui.reference.v1.ReferenceFrontendService.UpdateItem",
      "input": {
        "bindings": {
          "item_id": {
            "source": "route",
            "parameter": "path:itemId"
          },
          "expected_version": {
            "source": "initial",
            "field": "field:item.version"
          },
          "changes": {
            "source": "form"
          },
          "update_mask": {
            "source": "dirty_fields"
          }
        }
      },
      "output": {
        "resource": "resource:item",
        "itemPath": "item",
        "auditIdPath": "audit_id"
      },
      "idempotency": "supported",
      "consequence": "reversible",
      "invalidates": ["query:list-items", "query:get-item"],
      "requiredPermissions": {
        "kind": "permission",
        "permission": "permission:item.update"
      }
    },
    "command:decide-proposal": {
      "id": "command:decide-proposal",
      "service": "service:reference",
      "method": "oui.reference.v1.ReferenceFrontendService.DecideProposal",
      "input": {
        "bindings": {
          "proposal_id": {
            "source": "route",
            "parameter": "path:proposalId"
          },
          "expected_version": {
            "source": "query_output",
            "query": "query:get-decision-context",
            "path": "proposal.version"
          },
          "alternative_id": {
            "source": "interaction",
            "value": "selected_alternative"
          },
          "reason": {
            "source": "interaction",
            "value": "reason"
          }
        }
      },
      "output": {
        "resource": "resource:proposal",
        "itemPath": "proposal",
        "operationPath": "operation",
        "auditIdPath": "audit_id"
      },
      "idempotency": "required",
      "consequence": "irreversible",
      "invalidates": ["query:get-decision-context"],
      "requiredPermissions": {
        "kind": "permission",
        "permission": "permission:proposal.decide"
      },
      "confirmation": {
        "required": true,
        "message": {
          "id": "command.proposal.confirmation",
          "fallback": "Confirm this decision. It cannot be undone."
        }
      }
    }
  },
  "interactions": {
    "interaction:item-collection": {
      "id": "interaction:item-collection",
      "kind": "collection",
      "intent": "intent:inspect-collection",
      "label": {
        "id": "interaction.itemCollection.label",
        "fallback": "Items"
      },
      "subject": "resource:item",
      "queries": ["query:list-items"],
      "commands": [],
      "regions": [
        {
          "id": "region:item-collection.primary",
          "kind": "primary",
          "required": true
        }
      ],
      "collection": {
        "query": "query:list-items",
        "visibleFields": [
          "field:item.title",
          "field:item.status",
          "field:item.owner",
          "field:item.dueAt"
        ],
        "identityField": "field:item.id",
        "filters": [
          {
            "id": "filter:item.query",
            "kind": "text",
            "searchParameter": "search:query"
          },
          {
            "id": "filter:item.status",
            "kind": "multi_select",
            "field": "field:item.status",
            "searchParameter": "search:status"
          }
        ],
        "sorting": {
          "supportedFields": ["field:item.title", "field:item.status"],
          "default": {
            "field": "field:item.title",
            "direction": "ascending"
          }
        },
        "grouping": {
          "supported": false
        },
        "pagination": {
          "kind": "cursor"
        },
        "selection": {
          "minimum": 0,
          "maximum": 1
        },
        "emptyState": {
          "title": {
            "id": "interaction.itemCollection.empty.title",
            "fallback": "No items found"
          },
          "description": {
            "id": "interaction.itemCollection.empty.description",
            "fallback": "Change the filters or try again later."
          }
        },
        "itemRoute": "route:item-detail"
      },
      "presentation": {
        "preferredVariant": "table"
      }
    },
    "interaction:item-detail": {
      "id": "interaction:item-detail",
      "kind": "detail",
      "intent": "intent:inspect-resource",
      "label": {
        "id": "interaction.itemDetail.label",
        "fallback": "Item details"
      },
      "subject": "resource:item",
      "queries": ["query:get-item"],
      "commands": ["command:update-item"],
      "regions": [
        {
          "id": "region:item-detail.summary",
          "kind": "summary",
          "required": true,
          "fields": [
            "field:item.title",
            "field:item.status",
            "field:item.dueAt"
          ]
        },
        {
          "id": "region:item-detail.relationships",
          "kind": "relationships",
          "required": true,
          "relationships": [
            "relationship:item.owner",
            "relationship:item.related"
          ]
        },
        {
          "id": "region:item-detail.history",
          "kind": "history",
          "required": true,
          "sourceField": "field:item.history"
        }
      ],
      "detail": {
        "query": "query:get-item",
        "titleField": "field:item.title",
        "editRoute": "route:item-edit"
      }
    },
    "interaction:item-edit": {
      "id": "interaction:item-edit",
      "kind": "form",
      "intent": "intent:modify-resource",
      "label": {
        "id": "interaction.itemEdit.label",
        "fallback": "Edit item"
      },
      "subject": "resource:item",
      "queries": ["query:get-item"],
      "commands": ["command:update-item"],
      "requiredPermissions": {
        "kind": "permission",
        "permission": "permission:item.update"
      },
      "regions": [
        {
          "id": "region:item-edit.primary",
          "kind": "form",
          "required": true
        }
      ],
      "form": {
        "mode": "edit",
        "initialValues": {
          "source": "query",
          "query": "query:get-item",
          "path": "item"
        },
        "fields": [
          "field:item.title",
          "field:item.status",
          "field:item.owner",
